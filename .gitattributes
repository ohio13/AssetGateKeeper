# Normalise line endings in the repository: LF everywhere, even on Windows
# checkouts. Scripts here run on Linux runners and Windows agents alike, and a
# CRLF shebang or .yml is a needless class of bug.
* text=auto eol=lf

*.py     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.toml    text eol=lf
*.sh     text eol=lf

# Generated fixtures and DCC exports are binary; never diff or convert them.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.glb    binary
*.exr    binary
*.zip    binary

# Git's own housekeeping files.
.gitattributes text eol=lf
.gitignore     text eol=lf
