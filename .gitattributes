# Normalise line endings in the repository: LF everywhere, even on Windows
# checkouts. Scripts here run on Linux runners and Windows agents alike, and a
# CRLF shebang or .yml is a needless class of bug.
* text=auto eol=lf

*.py     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.toml    text eol=lf
*.sh     text eol=lf

# cmd.exe parses a batch file line by line and mis-handles multi-line
# "if ( ... )" blocks that arrive with bare LF endings, so .bat/.cmd are the one
# exception to the LF-everywhere rule above. They never run on Linux anyway.
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Generated fixtures and DCC exports are binary; never diff or convert them.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.glb    binary
*.exr    binary
*.zip    binary
# ASCII FBX is text, but a fixture must stay byte-for-byte what the exporter wrote.
*.fbx    binary
*.tga    binary

# Git's own housekeeping files.
.gitattributes text eol=lf
.gitignore     text eol=lf
