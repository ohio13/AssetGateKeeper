include README.md
include CONTRIBUTING.md
include SECURITY.md
include MANUAL.md
include QUICKSTART.md
include RELEASE_NOTES.md
include LICENSE
include THIRD_PARTY_NOTICES.md
include pyproject.toml
include asset_gatekeeper.example.toml
include templates/rules.toml
include *.bat
recursive-include server/static *
recursive-include tests *.py
recursive-include agk_gate *.py
recursive-include engine *.py
recursive-include tools *.py
recursive-include enterprise *.py
recursive-include agk_vendor *.py LICENSE py.typed
recursive-include plugins *.py *.md *.json *.cs *.asmdef *.meta *.gd *.cfg
recursive-include tests/unity_stubs *.cs *.csproj *.props *.config
recursive-include tests/godot_project *.godot *.gd
recursive-include docs *.md
prune .agk
prune build
prune dist
prune scratch
prune dropbox
global-exclude *.py[cod] __pycache__ *.db *.db-wal *.db-shm
