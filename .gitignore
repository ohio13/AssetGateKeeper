# --------------------------------------------------------------------------- #
# Python
# --------------------------------------------------------------------------- #
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
.eggs/

# --------------------------------------------------------------------------- #
# Build output and release artefacts
# --------------------------------------------------------------------------- #
build/
dist/
*.whl
*.tar.gz
*.zip

# --------------------------------------------------------------------------- #
# Local state: every database the servers create on first run, in any folder.
# A release tree must never carry an artist's library or a demo dashboard.
# --------------------------------------------------------------------------- #
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
asset_health.db
art_workstation.db
workstation_data/

# --------------------------------------------------------------------------- #
# Runtime files written next to a project
# --------------------------------------------------------------------------- #
.rules.cache.json
.rules.cache.json.tmp
.agk/
*.log

# --------------------------------------------------------------------------- #
# Test fixtures and scratch work
# --------------------------------------------------------------------------- #
dropbox/
scratch/
.pytest_cache/
.coverage
htmlcov/
*.tmp
*.bak
*.orig

# --------------------------------------------------------------------------- #
# Local editor / OS noise
# --------------------------------------------------------------------------- #
.DS_Store
Thumbs.db
.idea/
.vscode/

# certification reports (tools/certify.py)
certification/

# verdict cache written by --once runs
.agk-cache.json
.agk-ci-cache/

# --------------------------------------------------------------------------- #
# Personal notes and AI-assistant files: they stay on the developer's machine
# --------------------------------------------------------------------------- #
CLAUDE.md
CLAUDE.local.md
.claude/
HANDOFF*.md

# Godot writes its import cache here when tests/godot_project is opened in the editor.
.godot/
